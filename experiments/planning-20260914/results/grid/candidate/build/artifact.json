  "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=1280, initial-scale=1\">\n<title>一个网格，一次低买高卖</title>\n<style>\n@font-face{font-family:YingyaSans;src:url('assets/NotoSansCJK-Regular.ttc');font-weight:400;font-style:normal;font-display:block}\n@font-face{font-family:YingyaSans;src:url('assets/NotoSansCJK-Bold.ttc');font-weight:700;font-style:normal;font-display:block}\n*{box-sizing:border-box}html,body{margin:0;width:1280px;height:720px;overflow:hidden;background:#F6F4EE;color:#172D43;font-family:YingyaSans,sans-serif}\n#main{position:relative;width:1280px;height:720px;overflow:hidden;background:#F6F4EE}\n.scene{position:absolute;inset:0;pointer-events:none}.heading{position:absolute;left:80px;top:53px;margin:0;font-size:42px;line-height:1.4;font-weight:700;white-space:nowrap;opacity:0}\n#chart{position:absolute;inset:0;opacity:0}svg{position:absolute;inset:0;width:1280px;height:720px;overflow:visible}.axis-title{position:absolute;left:140px;top:149px;font-size:26px;line-height:36px}.tick{position:absolute;left:140px;width:65px;text-align:right;font-size:28px;line-height:40px}.tick100{top:200px}.tick90{top:380px}\n#initial{position:absolute;left:0;top:510px;width:1280px;text-align:center;font-size:32px;line-height:48px;opacity:0}\n.trade-label{position:absolute;font-size:27px;font-weight:700;line-height:42px;white-space:nowrap;opacity:0}#buy-label{left:559px;top:426px;color:#175DB5}#sell-label{left:942px;top:151px;color:#A94A19}\n#holding{position:absolute;left:564px;top:506px;width:132px;height:56px;opacity:0}#holding svg{width:132px;height:56px}#holding span{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:28px;line-height:40px;color:#175DB5}\n#formula,#final-state,#risk{position:absolute;left:80px;width:1120px;text-align:center;margin:0;opacity:0;white-space:nowrap}#formula{top:478px;font-size:36px;line-height:52px;font-weight:700}#final-state{top:534px;font-size:30px;line-height:44px}#risk{top:585px;font-size:28px;line-height:40px;font-weight:700}.buy{color:#175DB5}.sell{color:#A94A19}\n#footer{position:absolute;left:48px;right:48px;top:658px;text-align:center;font-size:20px;line-height:30px;white-space:nowrap}\n</style>\n</head>\n<body>\n<main id=\"main\" data-composition-id=\"main\" data-start=\"0\" data-duration=\"24\" data-width=\"1280\" data-height=\"720\" data-fps=\"30\">\n<div id=\"chart\" data-track-index=\"1\" data-scene-ids=\"scene-1 scene-2 scene-3 scene-4\">\n<svg viewBox=\"0 0 1280 720\" aria-label=\"价格从100元下降到90元，再回到100元；横向仅表示过程先后\">\n<g stroke=\"#172D43\" stroke-width=\"2\" opacity=\"0.23\"><line x1=\"225\" y1=\"220\" x2=\"1120\" y2=\"220\"/><line x1=\"225\" y1=\"400\" x2=\"1120\" y2=\"400\"/></g>\n<g fill=\"none\" stroke=\"#172D43\" stroke-width=\"5\" stroke-linecap=\"round\"><line id=\"down-path\" x1=\"240\" y1=\"220\" x2=\"240\" y2=\"220\" opacity=\"0\"/><line id=\"up-path\" x1=\"630\" y1=\"400\" x2=\"630\" y2=\"400\" opacity=\"0\"/></g>\n<circle id=\"start-point\" cx=\"240\" cy=\"220\" r=\"7\" fill=\"#172D43\" opacity=\"0\"/>\n<circle id=\"active-point\" cx=\"240\" cy=\"220\" r=\"8\" fill=\"#172D43\" opacity=\"0\"/>\n<circle id=\"buy-ring\" cx=\"630\" cy=\"400\" r=\"9\" fill=\"none\" stroke=\"#175DB5\" stroke-width=\"2\" opacity=\"0\"/>\n<g id=\"buy-event\" opacity=\"0\"><line x1=\"630\" y1=\"409\" x2=\"630\" y2=\"426\" stroke=\"#175DB5\" stroke-width=\"2\"/><circle cx=\"630\" cy=\"400\" r=\"9\" fill=\"#175DB5\"/></g>\n<g id=\"sell-event\" opacity=\"0\"><line x1=\"1020\" y1=\"192\" x2=\"1020\" y2=\"211\" stroke=\"#A94A19\" stroke-width=\"2\"/><circle cx=\"1020\" cy=\"220\" r=\"9\" fill=\"#A94A19\"/></g>\n</svg>\n<div class=\"axis-title\">价格（元）</div><div id=\"price-100\" class=\"tick tick100\">100</div><div id=\"price-90\" class=\"tick tick90\">90</div>\n</div>\n<section id=\"scene-1\" class=\"scene\" data-start=\"0\" data-duration=\"5\" data-track-index=\"2\">\n<h1 id=\"opening-title\" class=\"heading\">一个网格，一次低买高卖</h1><div id=\"initial\">初始：现金100元｜持仓0份</div>\n</section>\n<section id=\"scene-2\" class=\"scene\" data-start=\"5\" data-duration=\"6\" data-track-index=\"3\">\n<h2 id=\"buy-heading\" class=\"heading\">到90元，买入1份</h2>\n</section>\n<section id=\"scene-3\" class=\"scene\" data-start=\"11\" data-duration=\"6\" data-track-index=\"4\">\n<h2 id=\"sell-heading\" class=\"heading\">到100元，卖出这1份</h2>\n</section>\n<div id=\"buy-label\" class=\"trade-label\" data-track-index=\"5\" data-scene-ids=\"scene-2 scene-3 scene-4\">买入1份</div>\n<div id=\"sell-label\" class=\"trade-label\" data-track-index=\"6\" data-scene-ids=\"scene-3 scene-4\">卖出这1份</div>\n<div id=\"holding\" data-track-index=\"7\" data-scene-ids=\"scene-2 scene-3\"><svg viewBox=\"0 0 132 56\" aria-hidden=\"true\"><rect x=\"2\" y=\"2\" width=\"128\" height=\"52\" rx=\"12\" fill=\"#F6F4EE\" stroke=\"#175DB5\" stroke-width=\"2\"/></svg><span>这1份</span></div>\n<section id=\"scene-4\" class=\"scene\" data-start=\"17\" data-duration=\"7\" data-track-index=\"8\">\n<h2 id=\"result-title\" class=\"heading\">一个网格，一次低买高卖</h2>\n<p id=\"formula\"><span class=\"sell\">100元</span> − <span class=\"buy\">90元</span> = 10元价差</p>\n<p id=\"final-state\">最终：现金110元｜持仓0份</p>\n<p id=\"risk\">这次价差10元，不代表保证收益</p>\n</section>\n<footer id=\"footer\" data-track-index=\"9\">固定教学示例，非行情或投资建议；忽略手续费和滑点</footer>\n</main>\n<script src=\"assets/gsap.min.js\"></script>\n<script>\nconst tl=gsap.timeline({paused:true});\nwindow.__timelines=window.__timelines||{};\nwindow.__timelines.main=tl;\ntl.to({}, {duration:24},0);\ntl.fromTo('#opening-title',{opacity:0,y:8},{opacity:1,y:0,duration:0.45,ease:'power1.out'},0.1);\ntl.to('#chart',{opacity:1,duration:0.45},0.45);\ntl.to('#start-point',{opacity:1,duration:0.15},0.85);\ntl.to('#start-point',{attr:{r:10},duration:0.2,ease:'power1.out'},1);\ntl.to('#start-point',{attr:{r:7},duration:0.25,ease:'power1.inOut'},1.2);\ntl.to('#initial',{opacity:1,duration:0.35},1.15);\ntl.to(['#opening-title','#initial'],{opacity:0,duration:0.25},5);\ntl.set('#down-path',{attr:{opacity:1}},5);\ntl.set('#active-point',{attr:{opacity:1}},5);\ntl.to('#down-path',{attr:{x2:630,y2:400},duration:2,ease:'none'},5);\ntl.to('#active-point',{attr:{cx:630,cy:400},duration:2,ease:'none'},5);\ntl.set('#active-point',{attr:{opacity:0}},7);\ntl.fromTo('#buy-ring',{attr:{r:9,opacity:0.8}},{attr:{r:24,opacity:0},duration:0.55,ease:'power1.out'},7);\ntl.to('#buy-event',{attr:{opacity:1},duration:0.2},7.06);\ntl.fromTo('#buy-heading',{opacity:0,y:6},{opacity:1,y:0,duration:0.3},7.08);\ntl.fromTo('#buy-label',{opacity:0,y:5},{opacity:1,y:0,duration:0.3},7.12);\ntl.fromTo('#holding',{opacity:0,y:8,x:0},{opacity:1,y:0,x:0,duration:0.35,ease:'power1.out'},7.55);\ntl.to('#buy-heading',{opacity:0,duration:0.25},11);\ntl.set('#up-path',{attr:{opacity:1}},11);\ntl.set('#active-point',{attr:{opacity:1}},11);\ntl.to('#up-path',{attr:{x2:1020,y2:220},duration:2,ease:'none'},11);\ntl.to('#active-point',{attr:{cx:1020,cy:220},duration:2,ease:'none'},11);\ntl.set('#active-point',{attr:{opacity:0}},13);\ntl.to('#sell-event',{attr:{opacity:1},duration:0.2},13.06);\ntl.fromTo('#sell-heading',{opacity:0,y:6},{opacity:1,y:0,duration:0.3},13.08);\ntl.fromTo('#sell-label',{opacity:0,y:5},{opacity:1,y:0,duration:0.3},13.12);\ntl.to('#holding',{x:390,y:-226,duration:0.8,ease:'power1.inOut'},13.5);\ntl.to('#holding',{opacity:0,duration:0.25},14.3);\ntl.to('#sell-heading',{opacity:0,duration:0.2},17);\ntl.to('#result-title',{opacity:1,duration:0.25},17.2);\ntl.fromTo('#formula',{opacity:0,y:6},{opacity:1,y:0,duration:0.35},17.05);\ntl.fromTo('#final-state',{opacity:0,y:6},{opacity:1,y:0,duration:0.3},17.35);\ntl.fromTo('#risk',{opacity:0,y:6},{opacity:1,y:0,duration:0.3},17.7);\n</script>\n</body>\n</html>",
