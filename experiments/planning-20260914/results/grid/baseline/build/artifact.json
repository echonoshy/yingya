{
  "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=1280,initial-scale=1\"><title>一个网格，一次低买高卖</title><style>\n@font-face{font-family:YingyaSans;src:url('assets/NotoSansCJK-Regular.ttc');font-weight:400;font-style:normal;font-display:block}\n@font-face{font-family:YingyaSans;src:url('assets/NotoSansCJK-Bold.ttc');font-weight:700;font-style:normal;font-display:block}\n*{box-sizing:border-box}html,body{margin:0;width:1280px;height:720px;overflow:hidden;background:#F6F4EE}body{font-family:YingyaSans,sans-serif;color:#172D43}#main{position:relative;width:1280px;height:720px;background:#F6F4EE;overflow:hidden}h1,p{margin:0}.layer{position:absolute;inset:0;pointer-events:none}.text{position:absolute;white-space:nowrap}#title{left:64px;top:44px;font-size:44px;font-weight:700;line-height:1.4}.lead{left:64px;top:126px;font-size:32px;line-height:1.5;font-weight:700}#axis-title{left:64px;top:203px;font-size:26px}#price100{left:79px;top:264px;font-size:26px}#price90{left:93px;top:414px;font-size:26px}.trade{font-size:32px;font-weight:700;line-height:1.5;padding:3px 12px;border-radius:6px}#buy{left:455px;top:450px;color:#175DB5;background:#E8EEF5}#sell{left:884px;top:224px;color:#A94A19;background:#F3E9E1}#holding{left:730px;top:453px;width:78px;height:48px;border:2px solid #175DB5;border-radius:24px;background:#F6F4EE;color:#175DB5;font-size:26px;font-weight:700;text-align:center;line-height:43px}.state{font-size:28px;line-height:1.5;padding:8px 20px;background:#EEEDE6;border-radius:6px}#initial-state{left:390px;top:552px}#equation{left:405px;top:514px;font-size:40px;font-weight:700;line-height:1.5}#final-state{left:378px;top:580px}#recap{left:650px;top:304px;font-size:28px;font-weight:700;line-height:1.6}#boundary{left:650px;top:383px;font-size:36px;font-weight:700;line-height:1.5}#footer{left:64px;top:654px;font-size:20px;line-height:1.5}svg{position:absolute;inset:0;width:1280px;height:720px;overflow:hidden}.hidden{opacity:0;visibility:hidden}\n</style></head><body><main id=\"main\" data-composition-id=\"main\" data-start=\"0\" data-duration=\"24\" data-width=\"1280\" data-height=\"720\" data-fps=\"30\">\n<div class=\"layer\" data-track-index=\"1\"><h1 id=\"title\" class=\"text hidden\">一个网格，一次低买高卖</h1></div>\n<section id=\"scene-1\" class=\"layer\" data-start=\"0\" data-duration=\"4\" data-track-index=\"2\"><p id=\"intro\" class=\"text lead hidden\">只看一个网格的一次交易</p><p id=\"initial-state\" class=\"text state hidden\">初始现金100元 · 持仓0份</p></section>\n<section id=\"scene-2\" class=\"layer\" data-start=\"4\" data-duration=\"5\" data-track-index=\"3\"><p id=\"down-lead\" class=\"text lead hidden\">价格从100元降到90元</p></section>\n<section id=\"scene-3\" class=\"layer\" data-start=\"9\" data-duration=\"6\" data-track-index=\"4\"><p id=\"up-lead\" class=\"text lead hidden\">价格回到100元</p></section>\n<div id=\"shared-chart\" class=\"layer hidden\" data-start=\"0\" data-duration=\"24\" data-track-index=\"5\" data-scene-ids=\"scene-1 scene-2 scene-3 scene-4 scene-5\">\n<svg viewBox=\"0 0 1280 720\" aria-label=\"价格从100元下降到90元，再回到100元的单格示意图\">\n<rect id=\"grid-band\" x=\"160\" y=\"285\" width=\"990\" height=\"150\" fill=\"#172D43\" fill-opacity=\"0.045\"/>\n<line id=\"grid100\" x1=\"160\" y1=\"285\" x2=\"1150\" y2=\"285\" stroke=\"#172D43\" stroke-opacity=\"0.35\" stroke-width=\"2\"/>\n<line id=\"grid90\" x1=\"160\" y1=\"435\" x2=\"1150\" y2=\"435\" stroke=\"#172D43\" stroke-opacity=\"0.35\" stroke-width=\"2\"/>\n<line id=\"buy-highlight\" x1=\"573\" y1=\"435\" x2=\"667\" y2=\"435\" stroke=\"#175DB5\" stroke-width=\"4\" opacity=\"0\"/>\n<line id=\"down-path\" x1=\"200\" y1=\"285\" x2=\"200\" y2=\"285\" stroke=\"#172D43\" stroke-width=\"5\" stroke-linecap=\"round\" opacity=\"0\"/>\n<line id=\"up-path\" x1=\"620\" y1=\"435\" x2=\"620\" y2=\"435\" stroke=\"#172D43\" stroke-width=\"5\" stroke-linecap=\"round\" opacity=\"0\"/>\n<circle id=\"start-node\" cx=\"200\" cy=\"285\" r=\"8\" fill=\"#172D43\"/>\n<circle id=\"buy-node\" cx=\"620\" cy=\"435\" r=\"8\" fill=\"#175DB5\" opacity=\"0\"/>\n<circle id=\"price-dot\" cx=\"200\" cy=\"285\" r=\"8\" fill=\"#172D43\"/>\n</svg>\n<p id=\"axis-title\" class=\"text\">价格（元）</p><p id=\"price100\" class=\"text\">100</p><p id=\"price90\" class=\"text\">90</p>\n<p id=\"buy\" class=\"text trade hidden\">买入1份｜90元</p><p id=\"sell\" class=\"text trade hidden\">卖出该1份｜100元</p><p id=\"holding\" class=\"text hidden\">1份</p>\n</div>\n<section id=\"scene-4\" class=\"layer\" data-start=\"15\" data-duration=\"5\" data-track-index=\"6\"><p id=\"equation\" class=\"text hidden\">100 − 90 = 10元价差</p></section>\n<div class=\"layer\" data-start=\"15\" data-duration=\"9\" data-track-index=\"7\" data-scene-ids=\"scene-4 scene-5\"><p id=\"final-state\" class=\"text state hidden\">最终现金110元 · 持仓0份</p></div>\n<section id=\"scene-5\" class=\"layer\" data-start=\"20\" data-duration=\"4\" data-track-index=\"8\"><p id=\"recap\" class=\"text hidden\">90元买1份 → 100元卖该1份</p><p id=\"boundary\" class=\"text hidden\">10元价差 ≠ 保证收益</p></section>\n<div class=\"layer\" data-track-index=\"9\"><p id=\"footer\" class=\"text\">固定教学示例｜非行情或投资建议｜忽略手续费和滑点</p></div>\n</main><script src=\"assets/gsap.min.js\"></script><script>\n(function(){\nconst tl=gsap.timeline({paused:true});\nwindow.__timelines=window.__timelines||{};window.__timelines.main=tl;\nconst reveal=(s,t,d)=>tl.fromTo(s,{autoAlpha:0},{autoAlpha:1,duration:d,ease:'power1.out'},t);\nreveal('#title',0,0.65);reveal('#shared-chart',0.15,0.7);reveal('#intro',0.2,0.65);reveal('#initial-state',0.35,0.65);\ntl.fromTo('#price-dot',{attr:{r:6}},{attr:{r:8},duration:0.65,ease:'power1.out'},0.2);\ntl.set(['#intro','#initial-state'],{autoAlpha:0},4);reveal('#down-lead',4,0.3);\ntl.set('#down-path',{attr:{opacity:1}},4);\ntl.to('#down-path',{attr:{x2:620,y2:435},duration:2,ease:'none'},4);\ntl.to('#price-dot',{attr:{cx:620,cy:435},duration:2,ease:'none'},4);\ntl.set('#buy-node',{attr:{opacity:1}},6);\ntl.to('#buy-highlight',{attr:{opacity:1},duration:0.2},6);\nreveal('#buy',6,0.3);reveal('#holding',6,0.3);\ntl.set('#down-lead',{autoAlpha:0},9);reveal('#up-lead',9,0.3);\ntl.set('#up-path',{attr:{opacity:1}},9);\ntl.to('#up-path',{attr:{x2:1060,y2:285},duration:2.5,ease:'none'},9);\ntl.to('#price-dot',{attr:{cx:1060,cy:285},duration:2.5,ease:'none'},9);\nreveal('#sell',11.5,0.25);\ntl.to('#holding',{left:1084,top:227,autoAlpha:0,duration:0.5,ease:'power1.inOut'},11.5);\ntl.set('#up-lead',{autoAlpha:0},15);reveal('#equation',15,0.5);reveal('#final-state',15.3,0.5);\ntl.to('#equation',{autoAlpha:0,duration:0.3},20);\nconst move=(s,a)=>tl.to(s,{attr:a,duration:0.5,ease:'power1.inOut'},20);\nmove('#grid-band',{x:145,width:435});move('#grid100',{x1:145,x2:580});move('#grid90',{x1:145,x2:580});\nmove('#down-path',{x1:170,x2:345});move('#up-path',{x1:345,x2:545});move('#start-node',{cx:170});move('#buy-node',{cx:345});move('#price-dot',{cx:545});move('#buy-highlight',{x1:305,x2:385});\ntl.to('#buy',{left:218,top:452,fontSize:26,duration:0.5,ease:'power1.inOut'},20);\ntl.to('#sell',{left:340,top:230,fontSize:26,duration:0.5,ease:'power1.inOut'},20);\ntl.to('#final-state',{left:82,top:564,duration:0.5,ease:'power1.inOut'},20);\nreveal('#recap',20,0.5);reveal('#boundary',20,0.5);\ntl.to('#footer',{opacity:1,duration:3.5,ease:'none'},20.5);\n})();\n</script></body></html>",
