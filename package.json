{
  "name": "yingya",
  "version": "0.1.0",
  "private": true,
  "description": "映芽 · Yingya，把资料、想法和已有素材制作成能独立讲解、直接分享的视频。",
  "scripts": {
    "test": "npm run test:source && npm run test:release && npm run format:check && npm run lint:rust && npm run test:rust && npm run typecheck && npm run test:web && npm run test:heygen && npm run test:tts && npm run test:delivery && npm run test:production && npm run test:editorial && npm run test:product-video && npm run test:services && npm run test:design && npm run test:components && npm run test:anime && npm run web:build && npm run test:hyperframes && npm run test:product-video:visual && npm run test:knowledge:components && npm run test:ui",
    "format:check": "cargo fmt --all -- --check",
    "lint:rust": "cargo clippy --all-targets -- -D warnings",
    "web:dev": "vite --config web/vite.config.ts --host 0.0.0.0 --port 8798 --strictPort",
    "web:service:status": "bash scripts/dev-service.sh frontend status",
    "web:service:reload": "bash scripts/dev-service.sh frontend restart",
    "web:build": "vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test:web": "vitest run web/src --exclude \"**/.runtime/**\"",
    "test:heygen": "node --test tests/heygen-audio.test.mjs",
    "test:delivery": "python3 tests/video-delivery.test.py",
    "test:production": "python3 tests/production-task.test.py",
    "test:editorial": "python3 tests/media-analysis.test.py && node --test tests/editorial-composition.test.mjs",
    "test:tts": "node --test tests/voxcpm2-client.test.mjs",
    "test:rust": "cargo test --all-targets",
    "test:hyperframes": "npm --prefix tests/fixtures/hyperframes-smoke run check",
    "test:ui": "node tests/knowledge-browser.mjs && node tests/ui-qa.mjs",
    "test:marketing": "node tests/marketing-ui-qa.mjs",
    "test:avatar": "cargo build --locked && npm run web:build && node tests/avatar-browser.mjs",
    "test:admin": "node tests/admin-qa.mjs",
    "codex:version": "bash scripts/codex.sh --version",
    "codex:login-status": "bash scripts/codex.sh login status",
    "codex:app-server": "bash scripts/codex.sh app-server",
    "codex:upgrade": "npm install --save-exact @openai/codex@latest",
    "hyperframes:version": "hyperframes --version",
    "hyperframes:info": "HOME=$PWD/.runtime/hyperframes-home HYPERFRAMES_NO_UPDATE_CHECK=1 hyperframes info --json",
    "hyperframes:doctor": "HOME=$PWD/.runtime/hyperframes-home HYPERFRAMES_NO_UPDATE_CHECK=1 hyperframes doctor --json",
    "hyperframes:browser:ensure": "HOME=$PWD/.runtime/hyperframes-home HYPERFRAMES_NO_UPDATE_CHECK=1 hyperframes browser ensure",
    "hyperframes:browser:path": "HOME=$PWD/.runtime/hyperframes-home HYPERFRAMES_NO_UPDATE_CHECK=1 hyperframes browser path",
    "hyperframes:skills:install": "bash scripts/install-hyperframes-skills.sh",
    "heygen:skill:install": "bash scripts/install-heygen-audio-skill.sh",
    "voxcpm2:skill:install": "bash scripts/install-voxcpm2-skill.sh",
    "hyperframes:upgrade": "npm install --save-exact hyperframes@latest && npm run hyperframes:skills:install && npm run hyperframes:browser:ensure",
    "web:service:start": "bash scripts/dev-service.sh frontend start",
    "web:service:stop": "bash scripts/dev-service.sh frontend stop",
    "backend:service:start": "bash scripts/dev-service.sh backend start",
    "backend:service:stop": "bash scripts/dev-service.sh backend stop",
    "backend:service:restart": "bash scripts/dev-service.sh backend restart",
    "backend:service:status": "bash scripts/dev-service.sh backend status",
    "test:runtime": "cargo test runtime_tools_share -- --ignored --nocapture",
    "python:setup": "python3 scripts/setup-python.py",
    "test:services": "node --test tests/dev-service.test.mjs tests/sandbox-stdio.test.mjs tests/sandbox-gateway.test.mjs",
    "codex": "bash scripts/codex.sh",
    "codex:login": "bash scripts/codex.sh login",
    "release:build": "python3 scripts/release.py build",
    "release:activate": "python3 scripts/release.py activate",
    "release:status": "python3 scripts/release.py status",
    "test:rolling": "cargo build --locked && python3 tests/rolling-runtime.test.py",
    "test:components": "node --test tests/component-library.test.mjs tests/component-packs.test.mjs tests/magic-beam.test.mjs tests/three-model.test.mjs",
    "test:components:showcase": "node tests/unified-showcase.mjs",
    "test:components:live": "node tests/component-video-live.mjs",
    "test:anime": "node --test tests/anime-components.test.mjs tests/anime-preview.test.mjs",
    "test:design": "node --test tests/design-references.test.mjs tests/gsap-pack.test.mjs",
    "test:gsap:video": "node tests/gsap-video.mjs",
    "test:product-video": "node --test tests/product-video.test.mjs",
    "test:product-video:visual": "node tests/product-video-browser.mjs",
    "test:knowledge:ui": "node tests/knowledge-browser.mjs",
    "test:knowledge:components": "node tests/explanation-components.mjs",
    "test:source": "node scripts/check-source-usage.mjs",
    "release:prune": "python3 scripts/release.py prune",
    "test:release": "python3 tests/release-prune.test.py"
  },
  "dependencies": {
    "@chinese-fonts/lxgwwenkai": "3.0.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/codex": "0.154.0",
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/postcss": "4.3.3",
    "esbuild": "0.28.2",
    "gsap": "3.14.2",
    "hyperframes": "0.8.30",
    "postcss": "8.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "three": "0.186.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "playwright": "^1.62.1",
    "typescript": "5.9.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
