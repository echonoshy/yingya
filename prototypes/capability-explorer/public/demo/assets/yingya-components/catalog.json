{
  "schemaVersion": 1,
  "version": "1.0.0",
  "clock": "clock.js",
  "guide": "README.md",
  "components": [
    { "id": "title-reveal", "provider": "animejs", "name": "逐字标题", "purpose": "开场、章节和重点短句", "status": "bundled", "pack": "animejs", "catalog": "../animejs/catalog.json", "avoidDuplicate": ["@react-bits/SplitText-TS-CSS", "@magicui/word-pull-up"] },
    { "id": "flow-path", "provider": "animejs", "name": "线性流程", "purpose": "2–5 个有顺序的阶段", "status": "bundled", "pack": "animejs", "catalog": "../animejs/catalog.json", "alternative": "beam-network 用于分支或多路汇聚" },
    { "id": "number-compare", "provider": "animejs", "name": "数字对比", "purpose": "有来源的两组指标", "status": "bundled", "pack": "animejs", "catalog": "../animejs/catalog.json", "avoidDuplicate": ["@magicui/number-ticker"] },
    { "id": "beam-network", "provider": "magicui", "name": "分支与汇聚连线", "purpose": "多个输入汇聚、分支关系与系统连接", "status": "bundled", "pack": "magic-beam", "script": "magic-beam/magic-beam.js", "stylesheet": "magic-beam/magic-beam.css", "guide": "magic-beam/magic-beam.README.md", "alternative": "简单顺序流程优先 flow-path", "license": "MIT" },
    { "id": "model-stage", "provider": "threejs", "name": "本地 3D 模型展示", "purpose": "已有 GLB/glTF 模型的产品展台、旋转与模型动画", "status": "bundled", "pack": "three-model", "script": "three-model/model-scene.js", "module": true, "guide": "three-model/README.md", "requires": ["本地模型及全部纹理", "WebGL2"], "license": "MIT runtime; model assets separately licensed" }
  ],
  "sources": [
    { "id": "@react-bits", "kind": "source-registry", "status": "requires-adaptation", "purpose": "特色文字、图库、背景；先检索已有镜头", "registry": "https://reactbits.dev/r/{name}.json", "license": "MIT + Commons Clause" },
    { "id": "@magicui", "kind": "source-registry", "status": "requires-adaptation", "purpose": "现有镜头未覆盖的信息图与展示效果", "registry": "https://magicui.design/r/{name}.json", "license": "MIT public registry; Pro excluded" },
    { "id": "editorial", "kind": "installed-catalog", "catalog": "../editorial/catalog.json", "purpose": "真实录屏的聚焦、高亮和操作标注；保留已有装配器" },
    { "id": "hyperframes", "kind": "registry", "command": "hyperframes catalog --query TEXT --json", "purpose": "已为视频设计的镜头、转场和字幕；复用现有 CLI" }
  ]
