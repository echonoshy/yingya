{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "pack": "yingya-anime-scenes",
  "version": "1.0.0",
  "engine": { "name": "animejs", "version": "4.5.0", "license": "MIT", "localBundle": "anime.umd.min.js", "provenance": "PROVENANCE.json" },
  "entry": "scenes.js",
  "stylesheet": "scenes.css",
  "guide": "README.md",
  "designTokens": ["--yga-background", "--yga-foreground", "--yga-accent", "--yga-muted", "--yga-surface", "--yga-line", "--yga-font", "--yga-heading-weight", "--yga-radius"],
  "timing": "Create synchronously; autoplay:false; global __hfAnime seeks milliseconds. startSeconds is absolute composition time. GSAP controls scene container visibility. All effects end early and hold. Root data-duration controls export duration.",
  "commonSchema": {
    "type": "object",
    "required": ["component", "title", "startSeconds", "durationSeconds"],
    "properties": {
      "component": { "type": "string", "enum": ["title-reveal", "flow-path", "number-compare"] },
      "title": { "type": "string", "minLength": 1, "maxLength": 44 },
      "eyebrow": { "type": "string", "maxLength": 28 },
      "startSeconds": { "type": "number", "minimum": 0, "maximum": 86400 },
      "durationSeconds": { "type": "number", "minimum": 2, "maximum": 120 }
    }
  },
  "components": [
    {
      "id": "title-reveal",
      "name": "逐字标题与重点揭示",
      "purpose": "开场钩子、章节标题、短句卖点；文字逐字揭示后停留阅读，强调线与副标题分层入场。",
      "avoid": "长段说明、全部镜头都重复使用、没有内容层次的纯装饰开场。",
      "preview": "previews/title-reveal.png",
      "source": "scenes.js",
      "apis": ["splitText", "stagger", "createTimeline"],
      "references": ["https://animejs.com/documentation/text/splittext/", "https://animejs.com/documentation/utilities/stagger/"],
      "configSchema": {
        "type": "object",
        "properties": { "component": { "const": "title-reveal" }, "title": { "type": "string", "minLength": 1, "maxLength": 44 }, "subtitle": { "type": "string", "maxLength": 100 } }
      },
      "example": { "component": "title-reveal", "startSeconds": 0, "durationSeconds": 5, "eyebrow": "把想法变成视频", "title": "让内容，真正动起来", "subtitle": "选择成熟镜头，把时间留给表达。" }
    },
    {
      "id": "flow-path",
      "name": "流程描线与节点传递",
      "purpose": "2—5 步操作流程、信息流、任务阶段；路径随进度绘制，光点沿 SVG 连线运动，每个节点到达时揭示。竖屏自动纵向排列。",
      "avoid": "复杂分支图、无顺序关系的素材集合、隐藏布局后才初始化。",
      "preview": "previews/flow-path.png",
      "source": "scenes.js",
      "apis": ["svg.createDrawable", "svg.createMotionPath", "createTimeline"],
      "references": ["https://animejs.com/documentation/svg/createdrawable/", "https://animejs.com/documentation/svg/createmotionpath/"],
      "configSchema": {
        "type": "object",
        "required": ["nodes"],
        "properties": {
          "component": { "const": "flow-path" }, "title": { "type": "string", "minLength": 1, "maxLength": 28 },
          "nodes": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "object", "required": ["label"], "properties": { "label": { "type": "string", "minLength": 1, "maxLength": 12 }, "detail": { "type": "string", "maxLength": 32 } } } }
        }
      },
      "example": { "component": "flow-path", "startSeconds": 4.6, "durationSeconds": 6, "title": "从素材到成片，三步完成", "nodes": [{ "label": "上传素材", "detail": "照片、录屏或一段想法" }, { "label": "组织镜头", "detail": "把信息变成有节奏的叙事" }, { "label": "生成视频", "detail": "预览、调整与导出" }] }
    },
    {
      "id": "number-compare",
      "name": "双指标数字增长",
      "purpose": "有真实依据的成果、前后对比、两项关键指标；分层入场、数值增长并保持最终数值。装饰底线不表示数值比例。",
      "avoid": "没有来源的业绩数字、量纲不明的比较、把装饰底线当成比例图。",
      "preview": "previews/number-compare.png",
      "source": "scenes.js",
      "apis": ["createTimeline", "animate textContent", "modifier"],
      "references": ["https://animejs.com/documentation/animation/animatable-properties/javascript-object-properties/", "https://animejs.com/documentation/animation/tween-parameters/modifier/"],
      "configSchema": {
        "type": "object",
        "required": ["metrics"],
        "properties": {
          "component": { "const": "number-compare" }, "title": { "type": "string", "minLength": 1, "maxLength": 28 },
          "footnote": { "type": "string", "maxLength": 100 },
          "metrics": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "object", "required": ["label", "value"], "properties": { "label": { "type": "string", "minLength": 1, "maxLength": 20 }, "value": { "type": "number", "minimum": -9999999999999, "maximum": 9999999999999 }, "from": { "type": "number", "minimum": -9999999999999, "maximum": 9999999999999, "default": 0 }, "unit": { "type": "string", "maxLength": 8 }, "decimals": { "type": "integer", "minimum": 0, "maximum": 2, "default": 0 } } } }
        }
      },
      "example": { "component": "number-compare", "startSeconds": 10.2, "durationSeconds": 5.5, "title": "把数字讲清楚", "metrics": [{ "label": "第一组（演示）", "value": 24, "unit": "小时" }, { "label": "第二组（演示）", "value": 3.5, "unit": "小时", "decimals": 1 }], "footnote": "仅展示组件效果；正式视频请替换为有依据的数据与来源。" }
    }
  ]
}
